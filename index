<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Видеотитор — видеоуроки по школьной программе</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=PT+Sans:wght@400;700&display=swap" rel="stylesheet">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: 'PT Sans', Arial, sans-serif; background: #ffffff; color: #222222; line-height: 1.6; font-size: 17px; }
  header { border-bottom: 1px solid #d9d9d9; background: #f7f7f7; }
  .header-inner { max-width: 900px; margin: 0 auto; padding: 16px 20px; }
  .logo { font-size: 22px; font-weight: 700; color: #1a4d8f; }
  .header-note { font-size: 15px; color: #555555; margin-top: 2px; }
  main { max-width: 900px; margin: 0 auto; padding: 28px 20px 60px; }
  h1 { font-size: 26px; font-weight: 700; margin-bottom: 8px; line-height: 1.3; }
  .intro-text { font-size: 16px; color: #555555; margin-bottom: 24px; }
  
  .form-block { border: 1px solid #d9d9d9; border-radius: 6px; padding: 22px; margin-bottom: 26px; background: #ffffff; }
  .form-line { margin-bottom: 18px; }
  .form-line:last-child { margin-bottom: 0; }
  label { display: block; font-size: 15px; font-weight: 700; margin-bottom: 5px; }
  input[type="text"], select { font-family: inherit; font-size: 16px; color: #222222; background: #ffffff; border: 1px solid #b3b3b3; border-radius: 4px; padding: 10px 12px; width: 100%; outline: none; }
  input[type="text"]:focus, select:focus { border-color: #1a4d8f; }
  input[type="text"]::placeholder { color: #999999; }
  select { cursor: pointer; }
  
  .two-columns { display: flex; gap: 18px; flex-wrap: wrap; }
  .two-columns > div { flex: 1; min-width: 200px; }
  
  .source-options { display: flex; gap: 24px; padding-top: 4px; }
  .source-options label { display: flex; align-items: center; gap: 8px; font-weight: 400; font-size: 16px; cursor: pointer; margin-bottom: 0; }
  .source-options input[type="radio"] { width: 18px; height: 18px; cursor: pointer; accent-color: #1a4d8f; }
  
  button.find { font-family: inherit; font-size: 17px; font-weight: 700; color: #ffffff; background: #1a4d8f; border: none; border-radius: 4px; padding: 12px 20px; cursor: pointer; width: 100%; }
  button.find:hover { background: #143c70; }
  button.find:disabled { background: #8fa9c9; cursor: wait; }

  .message { border: 1px solid #d9d9d9; border-radius: 6px; padding: 20px; text-align: center; font-size: 16px; color: #555555; background: #fafafa; }
  .section-title { font-size: 20px; font-weight: 700; margin: 30px 0 16px; color: #1a4d8f; border-bottom: 2px solid #e5e5e5; padding-bottom: 6px; }
  .video-list { display: grid; gap: 18px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); margin-bottom: 20px; }
  
  .video-card { border: 1px solid #d9d9d9; border-radius: 6px; overflow: hidden; cursor: pointer; background: #ffffff; transition: border-color 0.2s; }
  .video-card:hover { border-color: #1a4d8f; }
  .video-card .preview { width: 100%; aspect-ratio: 16/9; background: #e8e8e8; display: block; object-fit: cover; }
  .video-card .info { padding: 12px 14px; }
  .video-card .name { font-size: 15px; font-weight: 700; line-height: 1.4; margin-bottom: 4px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.8em; }
  .video-card .author { font-size: 14px; color: #666666; }

  .window { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.7); display: none; align-items: center; justify-content: center; padding: 20px; z-index: 100; }
  .window.open { display: flex; }
  .window-box { width: 100%; max-width: 860px; }
  .window-video { width: 100%; aspect-ratio: 16/9; background: #000000; border-radius: 6px; overflow: hidden; }
  .window-video iframe { width: 100%; height: 100%; border: none; display: block; }
  .window-footer { background: #ffffff; border-radius: 6px; padding: 12px 16px; margin-top: 10px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .window-title { font-size: 15px; font-weight: 700; flex: 1; min-width: 150px; }
  .window-link { font-size: 14px; color: #1a4d8f; text-decoration: none; }
  .window-link:hover { text-decoration: underline; }
  .window-close { font-family: inherit; font-size: 16px; color: #222222; background: #eeeeee; border: 1px solid #cccccc; border-radius: 4px; padding: 6px 14px; cursor: pointer; }
  .window-close:hover { background: #e0e0e0; }
  
  footer { text-align: center; padding: 24px 20px; color: #777777; font-size: 14px; border-top: 1px solid #e5e5e5; }
  @media (max-width: 520px) { h1 { font-size: 22px; } .source-options { flex-direction: column; gap: 12px; } }
</style>
</head>
<body>

<header>
  <div class="header-inner">
    <div class="logo">Видеотитор</div>
    <div class="header-note">Видеоуроки по школьной программе</div>
  </div>
</header>

<main>
  <h1>Поиск видеоуроков</h1>
  <p class="intro-text">Введите тему урока, выберите класс и источник видео. Затем нажмите кнопку «Найти видеоуроки».</p>

  <div class="form-block">
    <div class="form-line">
      <label for="topic">Тема урока</label>
      <input id="topic" type="text" placeholder="Например: обыкновенные дроби, фотосинтез" autocomplete="off">
    </div>

    <div class="form-line two-columns">
      <div>
        <label for="grade">Класс</label>
        <select id="grade">
          <option value="">Любой класс</option>
          <option value="1">1 класс</option>
          <option value="2">2 класс</option>
          <option value="3">3 класс</option>
          <option value="4">4 класс</option>
          <option value="5">5 класс</option>
          <option value="6">6 класс</option>
          <option value="7">7 класс</option>
          <option value="8">8 класс</option>
          <option value="9">9 класс</option>
          <option value="10">10 класс</option>
          <option value="11">11 класс</option>
        </select>
      </div>
    </div>

    <div class="form-line">
      <label>Источник видео</label>
      <div class="source-options">
        <label><input type="radio" name="source" value="youtube" checked> YouTube</label>
        <label><input type="radio" name="source" value="rutube"> Rutube</label>
      </div>
    </div>

    <div class="form-line">
      <button class="find" id="go">Найти видеоуроки</button>
    </div>
  </div>

  <div id="status" class="message">Введите тему урока и нажмите «Найти видеоуроки».</div>
  <div id="results"></div>
</main>

<footer>Видеотитор — видеоуроки для школьников</footer>

<div class="window" id="window">
  <div class="window-box">
    <div class="window-video"><iframe id="frame" allowfullscreen allow="autoplay; encrypted-media; picture-in-picture"></iframe></div>
    <div class="window-footer">
      <div class="window-title" id="windowTitle"></div>
      <a class="window-link" id="openExternal" href="#" target="_blank" rel="noopener">Открыть на сайте</a>
      <button class="window-close" id="closeWindow">Закрыть</button>
    </div>
  </div>
</div>

<script>
// ВАША ССЫЛКА НА CLOUDFLARE WORKER
const PROXY = 'https://still-band-05c9.emkasemka04.workers.dev';

const $ = id => document.getElementById(id);
const topicEl = $('topic'), gradeEl = $('grade'), goEl = $('go');
const statusEl = $('status'), resultsEl = $('results');
const windowEl = $('window'), frame = $('frame'), windowTitle = $('windowTitle');
const openExternal = $('openExternal'), closeWindow = $('closeWindow');

function getSource() {
  const checked = document.querySelector('input[name="source"]:checked');
  return checked ? checked.value : 'youtube';
}

function placeholder(text) {
  return 'data:image/svg+xml;utf8,' + encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" width="320" height="180">
      <rect width="320" height="180" fill="#e8e8e8"/>
      <text x="160" y="94" font-family="PT Sans, Arial" font-size="14" fill="#888888"
        text-anchor="middle">${text}</text></svg>`);
}

function showMessage(text) {
  statusEl.textContent = text;
  statusEl.style.display = 'block';
  resultsEl.innerHTML = '';
}

function createCard(item) {
  const card = document.createElement('div');
  card.className = 'video-card';
  
  const img = document.createElement('img');
  img.className = 'preview'; img.alt = ''; img.loading = 'lazy';
  img.src = item.thumb || placeholder('Видеоурок');
  img.onerror = function () { this.src = placeholder('Нет превью'); };

  const info = document.createElement('div');
  info.className = 'info';
  const name = document.createElement('div');
  name.className = 'name'; name.textContent = item.title;
  const author = document.createElement('div');
  author.className = 'author'; author.textContent = item.channel || '';

  info.appendChild(name); info.appendChild(author);
  card.appendChild(img); card.appendChild(info);
  card.addEventListener('click', () => openVideo(item));
  return card;
}

function renderResults(items) {
  statusEl.style.display = 'none';
  resultsEl.innerHTML = '';

  if (!items || items.length === 0) {
    showMessage('Ничего не нашлось. Попробуйте изменить тему или класс.');
    return;
  }

  const topItems = items.slice(0, 3);
  const otherItems = items.slice(3);

  const topTitle = document.createElement('div');
  topTitle.className = 'section-title';
  topTitle.textContent = 'Лучшие видеоуроки по этой теме';
  resultsEl.appendChild(topTitle);

  const topGrid = document.createElement('div');
  topGrid.className = 'video-list';
  topItems.forEach(item => topGrid.appendChild(createCard(item)));
  resultsEl.appendChild(topGrid);

  if (otherItems.length > 0) {
    const otherTitle = document.createElement('div');
    otherTitle.className = 'section-title';
    otherTitle.textContent = 'Другие видеоуроки';
    resultsEl.appendChild(otherTitle);

    const otherGrid = document.createElement('div');
    otherGrid.className = 'video-list';
    otherItems.forEach(item => otherGrid.appendChild(createCard(item)));
    resultsEl.appendChild(otherGrid);
  }
}

function openVideo(item) {
  if (item.embed) {
    frame.src = item.embed;
    openExternal.href = item.embed;
    openExternal.style.display = 'inline';
  } else {
    frame.src = '';
    openExternal.style.display = 'none';
  }
  windowTitle.textContent = item.title;
  windowEl.classList.add('open');
}

function closeVideo() {
  windowEl.classList.remove('open');
  frame.src = '';
}

closeWindow.addEventListener('click', closeVideo);
windowEl.addEventListener('click', e => { if (e.target === windowEl) closeVideo(); });
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeVideo(); });

async function search() {
  const q = topicEl.value.trim();
  const grade = gradeEl.value;
  const source = getSource();

  if (!q) {
    showMessage('Введите тему урока. Например: «дроби» или «фотосинтез».');
    topicEl.focus();
    return;
  }

  goEl.disabled = true;
  goEl.textContent = 'Идёт поиск...';
  showMessage('Загружаем видеоуроки, подождите.');

  try {
    const params = new URLSearchParams({ q, grade, source });
    const resp = await fetch(`${PROXY}/?${params}`);
    const data = await resp.json();

    if (!data.ok) throw new Error(data.error || 'Ошибка при запросе');
    renderResults(data.items);
  } catch (e) {
    showMessage('Не удалось загрузить видео. Причина: ' + e.message);
  } finally {
    goEl.disabled = false;
    goEl.textContent = 'Найти видеоуроки';
  }
}

goEl.addEventListener('click', search);
topicEl.addEventListener('keydown', e => { if (e.key === 'Enter') search(); });
</script>
</body>
</html>
